generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id        Int      @id @default(autoincrement())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     Int
  sequence  Int
  label     String?

  // Joint positions (6 axes) and slider_joint position
  joint_1      Float
  joint_2      Float
  joint_3      Float
  joint_4      Float
  joint_5      Float
  joint_6      Float
  slider_joint Float

  // Task type
  taskType    String @default("move")  // "move" | "planning"
  planningMode String?                 // mode name for planning tasks

  // Settings
  speed       Int    @default(50)
  delay       Int    @default(0)
  gripper     Int    @default(0)
  controlMode String @default("joint")  // "joint" | "effector"

  // Cartesian end-effector pose (captured at teach time, used for IK in effector mode)
  x     Float?  // End-effector X in mm
  y     Float?  // End-effector Y in mm
  z     Float?  // End-effector Z in mm
  roll  Float?  // Roll in degrees
  pitch Float?  // Pitch in degrees
  yaw   Float?  // Yaw in degrees

  createdAt DateTime @default(now())
}

model Position {
  id          Int      @id @default(autoincrement())
  name        String
  joint_1      Float    @default(0)
  joint_2      Float    @default(0)
  joint_3      Float    @default(0)
  joint_4      Float    @default(0)
  joint_5      Float    @default(0)
  joint_6      Float    @default(0)
  slider_joint Float    @default(0)
  gripper     Int      @default(0)
  controlMode String   @default("joint")  // "joint" | "effector"
  x           Float?
  y           Float?
  z           Float?
  roll        Float?
  pitch       Float?
  yaw         Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
